{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "md-mcp-plugin": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "md_mcp_plugin"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONPATH": "${PLUGIN_ROOT}/src",
        "MD_MCP_HOST": "127.0.0.1",
        "MD_MCP_PORT": "7421",
        "MD_MCP_DATA_DIR": "${PLUGIN_ROOT}/.md-mcp-data"
      }
    }
  }
}

